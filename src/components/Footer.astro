---
// Keeps Starlight's default footer (edit link, pagination) and adds the
// same credit line used on saverio-cirillo.com.
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();
---

<Default />
<p class="credit">
	© {year} Saverio Cirillo · KRKplaysTennis is a fictional API · Built with{' '}
	<a href="https://starlight.astro.build" target="_blank" rel="noopener noreferrer">Starlight</a>
</p>

<style>
	.credit {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline-shade);
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}

	.credit a {
		color: var(--sl-color-gray-3);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.credit a:hover {
		color: var(--sl-color-text);
	}
</style>
