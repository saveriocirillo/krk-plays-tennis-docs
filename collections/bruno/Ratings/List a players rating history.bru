meta {
  name: List a player's rating history
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/players/plr_2b7xq9mhk4/rating-history?limit=20
  body: none
  auth: none
}

params:query {
  limit: 20
}

headers {
  X-API-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

docs {
  Reference: https://saverio-cirillo.com/krk-plays-tennis-api/reference/operations/listplayerratinghistory/
}
