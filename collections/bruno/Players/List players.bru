meta {
  name: List players
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/players?limit=20
  body: none
  auth: none
}

params:query {
  limit: 20
}

headers {
  X-API-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

docs {
  Reference: https://saverio-cirillo.com/portfolio/reference/operations/listplayers/
}
