meta {
  name: List competitions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/competitions?season=2026-autumn
  body: none
  auth: none
}

params:query {
  season: 2026-autumn
}

headers {
  X-API-Key: {{apiKey}}
}

assert {
  res.status: eq 200
}

docs {
  Reference: https://saverio-cirillo.com/portfolio/reference/operations/listcompetitions/
}
